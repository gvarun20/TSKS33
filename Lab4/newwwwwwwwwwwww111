graph, node_values = genLiveJournal()
num_samples = 10000

print("\n--- Task 1: Exact Values and Sampling Estimates ---")
exact_mean = compute_exact_mean(graph, node_values)
print(f"Exact mean (uniform sampling): {exact_mean:.3f}")

random_connection_mean = estimate_random_connection(graph, node_values)
print(f"Random connection sampling mean: {random_connection_mean:.3f}")

random_walk_mean = estimate_random_walk(graph, node_values)
print(f"Uniform random walk mean: {random_walk_mean:.3f}")

print("\n--- Task 2: Uniform Sampling ---")
for i in range(5):
    rnd = snap.TRnd(i * 1000)
    rnd.Randomize()
    sample_sum = sum(node_values[graph.GetRndNId(rnd)] for _ in range(num_samples))
    print(f"Iteration {i}: {sample_sum / num_samples:.3f}")

print("\n--- Task 3: Random Connection from Random Node ---")
for i in range(5):
    rnd = snap.TRnd(randint(0, 100000000))
    rnd.Randomize()
    sample_sum = 0
    for _ in range(num_samples):
        random_node_id = graph.GetRndNId(rnd)
        random_node = graph.GetNI(random_node_id)
        degree = random_node.GetDeg()
        if degree > 0:
            random_neighbor_id = random_node.GetNbrNId(randint(0, degree - 1))
            sample_sum += node_values[random_neighbor_id]
    print(f"Iteration {i}: {sample_sum / num_samples:.3f}")

print("\n--- Task 4: Uniform Random Walk ---")
for i in range(5):
    rnd = snap.TRnd(randint(0, 100000000))
    rnd.Randomize()
    random_node_id = graph.GetRndNId(rnd)
    iterator = graph.GetNI(random_node_id)

    # Reach steady state
    for _ in range(num_samples):
        degree = iterator.GetDeg()
        if degree > 0:
            random_neighbor_id = iterator.GetNbrNId(randint(0, degree - 1))
            iterator = graph.GetNI(random_neighbor_id)

    # Begin sampling
    sample_sum = 0
    for _ in range(num_samples):
        degree = iterator.GetDeg()
        if degree > 0:
            random_neighbor_id = iterator.GetNbrNId(randint(0, degree - 1))
            iterator = graph.GetNI(random_neighbor_id)
        sample_sum += node_values[iterator.GetId()]
    print(f"Iteration {i}: {sample_sum / num_samples:.3f}")

print("\n--- Task 5: Metropolis-Hastings Random Walk ---")
for i in range(5):
    mh_mean = sample_using_mh_walk(graph, node_values, num_samples)
    print(f"Iteration {i}: {mh_mean:.3f}")

print("\nAll tasks completed successfully.")
